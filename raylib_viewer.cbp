<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="raylib_viewer" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/raylib_viewer" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-std=gnu++17" />
					<Add option="-g" />
					<Add directory="/usr/include" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-lraylib -lGL -lm -pthread -ldl -lrt" />
					<Add directory="/usr/lib" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/raylib_viewer" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="include/common.h" />
		<Unit filename="include/movemenu.h" />
		<Unit filename="include/openmenu.h" />
		<Unit filename="include/rotatemenu.h" />
		<Unit filename="include/savemenu.h" />
		<Unit filename="include/scalemenu.h" />
		<Unit filename="main.cpp" />
		<Unit filename="src/common.cpp" />
		<Unit filename="src/movemenu.cpp" />
		<Unit filename="src/openmenu.cpp" />
		<Unit filename="src/rotatemenu.cpp" />
		<Unit filename="src/savemenu.cpp" />
		<Unit filename="src/scalemenu.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
